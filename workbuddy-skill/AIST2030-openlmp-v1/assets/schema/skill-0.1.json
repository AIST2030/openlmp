{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://openlmp.org/schema/skill-0.1.json",
  "title": "OpenLMP Learning Method Skill",
  "description": "OpenLMP 学习方法 Skill 标准格式 v0.1。所有 Skill 必须是纯 JSON、无执行代码、可被任意 Agent 解释执行的声明式描述。",
  "type": "object",
  "required": ["lmp", "id", "name", "version", "license", "description", "steps"],
  "additionalProperties": false,
  "properties": {
    "lmp": {
      "const": "0.1",
      "description": "协议版本"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "全局唯一 slug，kebab-case"
    },
    "name": { "type": "string", "description": "中文名" },
    "name_en": { "type": "string" },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "license": {
      "type": "string",
      "enum": ["CC0-1.0", "CC-BY-4.0"],
      "description": "方法本身属公共领域；CC-BY 仅在附带文字说明时使用"
    },
    "authors": {
      "type": "array",
      "items": { "type": "string" },
      "description": "贡献者署名，格式 name OR github:handle OR cid:xxx"
    },
    "category": {
      "type": "string",
      "enum": [
        "理解构建", "记忆巩固", "技能习得", "知识管理",
        "计划执行", "元认知", "协作学习", "评测验证"
      ]
    },
    "evidence": {
      "type": "string",
      "enum": ["high", "medium", "anecdotal"],
      "description": "循证等级：high=有 meta-analysis 支持；medium=有对照实验；anecdotal=传统经验/专家经验"
    },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string" },
      "description": "DOI / URL / 书名页码，evidence!=high 时可为空"
    },
    "description": {
      "type": "string",
      "description": "一句话说明解决什么问题"
    },
    "when_to_use": {
      "type": "array",
      "items": { "type": "string" },
      "description": "触发场景关键词，供 Agent 匹配"
    },
    "when_not_to_use": {
      "type": "array",
      "items": { "type": "string" }
    },
    "params": {
      "type": "object",
      "description": "输入参数，JSON Schema draft-07 片段",
      "properties": {
        "type": { "const": "object" },
        "required": { "type": "array", "items": { "type": "string" } },
        "properties": { "type": "object" }
      }
    },
    "requires": {
      "type": "object",
      "properties": {
        "tools": {
          "type": "array",
          "items": { "type": "string" },
          "description": "所需工具能力关键词，Agent 自行判断是否满足；不可用时必须走 degrade_to"
        },
        "assets": { "type": "array", "items": { "type": "string" } }
      },
      "default": { "tools": [], "assets": [] }
    },
    "steps": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "name", "instruction", "checkpoint"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string" },
          "instruction": {
            "type": "string",
            "description": "自然语言指令。必须写成「Agent 可以直接执行的动作」，禁止写「用户自行决定」"
          },
          "duration_min": { "type": "integer", "minimum": 1 },
          "checkpoint": {
            "type": "string",
            "description": "本步骤完成判据。不可自我循环，必须可客观判定"
          },
          "output": { "type": "string", "description": "本步骤产出物 schema 描述" },
          "fail_to": {
            "type": "string",
            "description": "未达成 checkpoint 时跳转到的 step id；缺省表示原地重试一次"
          }
        }
      }
    },
    "evaluate": {
      "type": "object",
      "properties": {
        "self_check": {
          "type": "array",
          "items": { "type": "string" },
          "description": "结束时必须逐条回答的自检问题"
        },
        "success_criteria": {
          "type": "array",
          "items": { "type": "string" },
          "description": "判定本方法生效的客观标准"
        }
      },
      "required": ["self_check"]
    },
    "agent_contract": {
      "type": "object",
      "description": "供任意 Agent 的接入契约",
      "properties": {
        "input": { "type": "array", "items": { "type": "string" } },
        "output": { "type": "array", "items": { "type": "string" } },
        "side_effects": {
          "type": "array",
          "items": { "type": "string" },
          "description": "允许的副作用，缺省=纯函数无副作用"
        },
        "degrade_to": {
          "type": "string",
          "description": "工具缺失时的降级路径说明"
        }
      }
    },
    "resources": {
      "type": "array",
      "description": "知识来源路由。OpenLMP 不存内容，只存「去哪取」的规则",
      "items": {
        "type": "object",
        "required": ["type", "locator"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["url", "openstax", "wikisource", "arxiv", "local", "ipfs"]
          },
          "locator": { "type": "string" },
          "license_hint": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" },
        "contributors": { "type": "array", "items": { "type": "string" } },
        "supersedes": { "type": "string" }
      }
    }
  }
}